<Window x:Class="POC.Localization.WPF.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POC.Localization.WPF.App"
        xmlns:fw="clr-namespace:POC.Localization.WPF.Framework;assembly=POC.Localization.WPF.Framework"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <TextBlock Text="{Binding Path=Value, Source={fw:CLocalise ResourceProvider={x:Static local:CResourceProvider.UI_Text}}}" />
        <TextBlock Text="{Binding Path=Value, Source={fw:CLocalise ResourceProvider={x:Static local:CResourceProvider.UI_Text2}}}" />
        <TextBlock Text="{Binding Path=Value, Source={fw:CLocalise ResourceProvider={x:Static local:CResourceProvider.UI_Text3}}}" />
        <Button Click="TranslateToCulture1" Content="Translate to culture 1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Click="TranslateToCulture2" Content="Translate to culture 2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </StackPanel>
</Window>
